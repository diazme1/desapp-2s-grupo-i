PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/football_market
JWT_SECRET=change-this-secret-with-at-least-32-characters
JWT_EXPIRES_IN=2h
JWT_ALGORITHM=HS256
# Cadena base64url generada desde al menos 32 bytes para el header X-API-Key; generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CATALOG_REFRESH_API_KEY=
FOOTBALL_DATA_API_URL=https://api.football-data.org/v4
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_COMPETITIONS=PL,BL1,PD,SA,FL1
FOOTBALL_DATA_MAX_TEAMS=
FOOTBALL_DATA_REQUEST_DELAY_MS=6000
WHOSCORED_BROWSER_EXECUTABLE_PATH=
WHOSCORED_BROWSER_HEADLESS=true
WHOSCORED_BROWSER_TIMEOUT_MS=45000
WHOSCORED_NUMBER_OF_PLAYERS=3000
