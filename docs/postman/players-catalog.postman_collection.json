{
  "info": {
    "name": "Cotizaciones y jugadores",
    "description": "Ejecutar primero 'Iniciar sesión (superadmin)': guarda accessToken para las requests protegidas. El entrenamiento ML deja disponible un modelo y devuelve sus métricas; la predicción devuelve cotización actual y posible. El recálculo crea ambas estrategias; el ranking permite consultar cada estrategia sin recalcular.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "catalogRefreshApiKey", "value": "", "type": "string" },
    { "key": "playerId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Iniciar sesión (superadmin compartido)",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo\": \"admin@gmail.com\",\n  \"password\": \"admin\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/auth/login",
        "description": "Credenciales compartidas de desarrollo. El test guarda el JWT en accessToken para usarlo en las requests protegidas."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Login exitoso', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Devuelve un accessToken', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
        "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);"
      ] } }]
    },
    {
      "name": "Verificar usuario autenticado",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "header": [],
        "url": "{{baseUrl}}/auth/me",
        "description": "Ejecutar después del login; confirma que el token corresponde al superadmin."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Token válido', () => pm.response.to.have.status(200));",
        "pm.test('La cuenta es superadmin', () => pm.expect(pm.response.json()).to.have.property('rol', 'superadmin'));"
      ] } }]
    },
    {
      "name": "Actualizar catálogo base",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "header": [{ "key": "X-API-Key", "value": "{{catalogRefreshApiKey}}", "type": "text" }],
        "url": "{{baseUrl}}/catalog/refresh?ligaCodigo=PL",
        "description": "Importa una liga, sus equipos y jugadores desde Football-Data.org. Requiere JWT Bearer y X-API-Key."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde actualización exitosa', () => pm.response.to.have.status(200));",
        "pm.test('Devuelve resumen del catálogo y estadísticas', () => pm.expect(pm.response.json()).to.have.all.keys('fuente', 'ligas', 'equipos', 'jugadores', 'tiempoExtraccionMs', 'tiempoExtraccion', 'actualizadoEn', 'estadisticas'));",
        "pm.test('Devuelve resumen agregado de estadísticas', () => pm.expect(pm.response.json().estadisticas).to.have.all.keys('estado', 'procesados', 'exitosos', 'parciales', 'fallidos', 'motivoSinMatch'));"
      ] } }]
    },
    {
      "name": "Listar jugadores",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [],
        "url": "{{baseUrl}}/players",
        "description": "Lee el catálogo local sin llamar a fuentes externas."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('Devuelve una lista', () => pm.expect(pm.response.json()).to.be.an('array'));",
        "if (pm.response.json().length > 0) pm.collectionVariables.set('playerId', pm.response.json()[0].id);"
      ] } }]
    },
    {
      "name": "Obtener detalle de jugador",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [],
        "url": "{{baseUrl}}/players/{{playerId}}",
        "description": "Devuelve los datos base del jugador y sus relaciones. Ejecutar después de listar jugadores."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('Devuelve jugador, equipo y liga', () => pm.expect(pm.response.json()).to.have.all.keys('id', 'nombre', 'nombreCompleto', 'posicion', 'fechaNacimiento', 'nacionalidad', 'equipo', 'liga'));"
      ] } }]
    },
    {
      "name": "Historial de cotizaciones de jugador",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [],
        "url": "{{baseUrl}}/players/{{playerId}}/quotes?page=1&limit=20",
        "description": "Devuelve el historial del jugador más reciente primero. page inicia en 1; limit es 20 por defecto y admite hasta 100. La respuesta incluye items, page, limit, total y totalPages. La apertura de mercado puede tener idRecalculo e idEstadistica nulos; las cotizaciones calculadas conservan ambas referencias. Ejecutar después de listar jugadores."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Devuelve el sobre de paginación', () => pm.expect(body).to.have.all.keys('items', 'page', 'limit', 'total', 'totalPages'));",
        "pm.test('Devuelve una lista de cotizaciones', () => pm.expect(body.items).to.be.an('array'));",
        "if (body.items.length > 0) pm.test('Incluye datos y procedencia de cotización', () => pm.expect(body.items[0]).to.have.all.keys('id', 'idJugador', 'fechaHora', 'cotizacion', 'tipoEstrategia', 'idVersionEstrategia', 'idRecalculo', 'idEstadistica'));",
        "if (body.items.length > 0 && body.items[0].tipoEstrategia === 'apertura_mercado') pm.test('La apertura usa cotización 1.00 y procedencia nula', () => { pm.expect(body.items[0].cotizacion).to.eql(1); pm.expect(body.items[0].idRecalculo).to.eql(null); pm.expect(body.items[0].idEstadistica).to.eql(null); });"
      ] } }]
    },
    {
      "name": "Entrenar modelo ML (superadmin)",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": { "mode": "raw", "raw": "{\n  \"origenDatos\": \"synthetic\",\n  \"snapshots\": [\n    {\"playerId\": \"fixture-player\", \"season\": \"2025\", \"date\": \"2025-01-01\", \"statistics\": {\"goles\": 1, \"asistencias\": 1, \"tiros\": 5, \"pasesClave\": 2, \"regates\": 3, \"faltasCometidas\": 1, \"rating\": 6.5}},\n    {\"playerId\": \"fixture-player\", \"season\": \"2025\", \"date\": \"2025-01-16\", \"statistics\": {\"goles\": 1, \"asistencias\": 2, \"tiros\": 6, \"pasesClave\": 3, \"regates\": 4, \"faltasCometidas\": 1, \"rating\": 6.7}},\n    {\"playerId\": \"fixture-player\", \"season\": \"2025\", \"date\": \"2025-01-31\", \"statistics\": {\"goles\": 2, \"asistencias\": 2, \"tiros\": 7, \"pasesClave\": 3, \"regates\": 5, \"faltasCometidas\": 2, \"rating\": 6.9}},\n    {\"playerId\": \"fixture-player\", \"season\": \"2025\", \"date\": \"2025-02-15\", \"statistics\": {\"goles\": 2, \"asistencias\": 3, \"tiros\": 8, \"pasesClave\": 4, \"regates\": 6, \"faltasCometidas\": 2, \"rating\": 7.1}}\n  ]\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/ml-players/train",
        "description": "Entrena sincrónicamente el modelo y lo deja disponible. Requiere el JWT del superadmin. La respuesta HTTP 200 contiene versionModelo, versionDataset, versionTransformaciones, cantidadEjemplos y metricas. Los datos synthetic solo sirven para validar técnicamente el flujo."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Entrenamiento finalizado', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.expect(body.estado).to.eql('entrenado');",
        "pm.expect(body.versionModelo).to.be.a('string').and.not.empty;",
        "pm.expect(body.versionDataset).to.be.a('string').and.not.empty;",
        "pm.expect(body.metricas).to.have.property('prueba');",
        "pm.expect(body.metricas).to.have.property('baselinePrueba');"
      ] } }]
    },
    {
      "name": "Consultar predicción y cotización posible",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "header": [],
        "url": "{{baseUrl}}/players/{{playerId}}/prediction",
        "description": "Devuelve la cotización actual y la cotización predicha. La predicha puede ser null si no hay modelo, estadísticas o estrategia. Ejecutar después de listar jugadores y, opcionalmente, entrenar el modelo."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Predicción consultada', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "['estado', 'cotizacionActual', 'cotizacionPredicha', 'prediccionDisponible', 'fechaGeneracion', 'fechaObjetivo', 'versionModelo', 'versionEstrategia', 'origenDatos'].forEach((key) => pm.expect(body).to.have.property(key));",
        "pm.expect(body.estado).to.be.oneOf(['disponible', 'no_disponible']);",
        "pm.expect(body.cotizacionActual === null || /^\\d+\\.\\d{2}$/.test(body.cotizacionActual)).to.eql(true);",
        "pm.expect(body.cotizacionPredicha === null || /^\\d+\\.\\d{2}$/.test(body.cotizacionPredicha)).to.eql(true);"
      ] } }]
    },
    {
      "name": "Recalcular cotizaciones (superadmin)",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": { "mode": "raw", "raw": "{\n  \"estrategia\": \"ataque_decisivo\",\n  \"pesosEstrategias\": {\n    \"ataque_decisivo\": { \"goles\": 35, \"asistencias\": 25, \"tiros\": 20, \"pasesClave\": 5, \"regates\": 5, \"rating\": 5, \"faltasCometidas\": 5 },\n    \"creacion_tecnica\": { \"goles\": 5, \"asistencias\": 15, \"tiros\": 5, \"pasesClave\": 30, \"regates\": 25, \"rating\": 15, \"faltasCometidas\": 5 }\n  }\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/quotes/recalculate",
        "description": "Calcula ambas estrategias sincrónicamente usando estadísticas locales; el body elige cuál queda activa para compras/ventas y puede enviar los pesos configurables de ambas estrategias. Cada conjunto de pesos debe sumar 100. Si los pesos cambian, se guarda una nueva versión inmutable asociada a las cotizaciones. Requiere el JWT de un superadmin; no ejecuta el scraper. Cambiar el filtro del ranking no vuelve a calcular. Las faltas restan."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde después de una corrida exitosa', () => pm.response.to.have.status(200));",
        "pm.test('Devuelve ambas estrategias y la corrida activa elegida', () => pm.expect(pm.response.json()).to.have.all.keys('idRecalculo', 'estrategia', 'estrategiasCalculadas', 'versionEstrategia', 'fechaHora', 'jugadoresCotizados', 'jugadoresSinEstadisticas'));"
      ] } }]
    },
    {
      "name": "Ranking por estrategia",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [],
        "url": "{{baseUrl}}/players/ranking?estrategia=ataque_decisivo",
        "description": "Consulta cotizaciones vigentes por estrategia sin recalcular. Se puede cambiar estrategia por ataque_decisivo o creacion_tecnica; sin filtro usa la estrategia activa."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('Devuelve estrategia y ranking', () => pm.expect(pm.response.json()).to.have.all.keys('estrategia', 'idRecalculo', 'fechaHora', 'jugadores'));",
        "pm.test('Cotizaciones descendentes', () => { const jugadores = pm.response.json().jugadores; for (let i = 1; i < jugadores.length; i++) pm.expect(jugadores[i - 1].cotizacion).to.be.at.least(jugadores[i].cotizacion); });"
      ] } }]
    },
    {
      "name": "Ranking - Creación y técnica",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [],
        "url": "{{baseUrl}}/players/ranking?estrategia=creacion_tecnica",
        "description": "Consulta el ranking de creación y técnica sin recalcular ni cambiar la estrategia activa."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('Usa creación y técnica', () => pm.expect(pm.response.json().estrategia).to.eql('creacion_tecnica'));"
      ] } }]
    },
    {
      "name": "Ranking - Estrategia activa",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [],
        "url": "{{baseUrl}}/players/ranking",
        "description": "Consulta la estrategia actualmente seleccionada para compras/ventas."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('Devuelve una estrategia válida o ninguna si no hay recálculo', () => pm.expect([null, 'ataque_decisivo', 'creacion_tecnica']).to.include(pm.response.json().estrategia));"
      ] } }]
    }
  ]
}
