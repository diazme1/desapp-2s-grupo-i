{
  "info": {
    "name": "App base del backend",
    "description": "Comprobación de salud del backend. Ajustar baseUrl al puerto local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key": "baseUrl", "value": "http://localhost:3000", "type": "string"}],
  "item": [{
    "name": "Consultar salud",
    "request": {"method": "GET", "auth": {"type": "noauth"}, "header": [], "url": "{{baseUrl}}/health", "description": "Confirma que el servidor responde; no consulta base de datos."},
    "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
      "pm.test('Responde HTTP 200', () => pm.response.to.have.status(200));",
      "pm.test('Devuelve JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
      "pm.test('Estado exacto sin campos adicionales', () => pm.expect(pm.response.json()).to.deep.equal({status: 'ok'}));"
    ]}}]
  }]
}
